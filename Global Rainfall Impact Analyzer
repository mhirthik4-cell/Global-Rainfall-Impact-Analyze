# 4. CLIMATOLOGICAL BASELINE & ANOMALIES (1991–2020 WMO Standard)
# ==============================================================================
print("\n[3/5] Calculating 1991–2020 Climatological Normals & Standardized Z-Scores...")

base_mask = (master["year"] >= 1991) & (master["year"] <= 2020)
base_stats = master[base_mask].groupby("country_iso3")["rainfall_mm"].agg(["mean", "std"]).reset_index()
base_stats.columns = ["country_iso3", "baseline_mean", "baseline_std"]
master = pd.merge(master, base_stats, on="country_iso3", how="left")

# Anomaly derivations
master["rainfall_anomaly_mm"] = master["rainfall_mm"] - master["baseline_mean"]
master["rainfall_anomaly_pct"] = (master["rainfall_anomaly_mm"] / master["baseline_mean"]) * 100.0
master["rainfall_zscore"] = master["rainfall_anomaly_mm"] / master["baseline_std"]

# Crop yield anomaly
c_mean = master.groupby("country_iso3")["crop_yield_kg_ha"].transform("mean")
master["crop_yield_anomaly_pct"] = ((master["crop_yield_kg_ha"] - c_mean) / c_mean) * 100.0

# Meteorological deficit indicator (Z <= -1.0)
master["is_dry_year"] = master["rainfall_zscore"].apply(lambda z: 1 if pd.notna(z) and z <= -1.0 else 0)

print(f"  ✓ Harmonized Panel: {len(master)} country-years across {master['country_iso3'].nunique()} countries.")

# ==============================================================================
# 5. EMPIRICAL STATISTICAL ANALYSES
# ==============================================================================
print("\n[4/5] Executing Research Analyses...")

# Analysis 1: Flood vs Non-Flood Rainfall Anomaly
flood_y = master[master["has_recorded_flood"] == 1]["rainfall_anomaly_pct"].dropna()
non_flood_y = master[master["has_recorded_flood"] == 0]["rainfall_anomaly_pct"].dropna()
u_stat, u_pval = stats.mannwhitneyu(flood_y, non_flood_y, alternative="two-sided") if len(flood_y) >= 3 else (np.nan, np.nan)

# Analysis 2: Crop Yield vs Rainfall Anomaly Correlation
crop_valid = master.dropna(subset=["rainfall_anomaly_pct", "crop_yield_anomaly_pct"])
r_crop, p_crop = stats.pearsonr(crop_valid["rainfall_anomaly_pct"], crop_valid["crop_yield_anomaly_pct"]) if len(crop_valid) >= 5 else (np.nan, np.nan)

# Analysis 3: Macroeconomic Transmission Stratification (Agri Share >= 10% vs < 10%)
econ_valid = master.dropna(subset=["rainfall_anomaly_pct", "gdp_growth_pct", "agri_gdp_share_pct"])
high_agri = econ_valid[econ_valid["agri_gdp_share_pct"] >= 10.0]
low_agri = econ_valid[econ_valid["agri_gdp_share_pct"] < 5.0]

r_high, p_high = stats.pearsonr(high_agri["rainfall_anomaly_pct"], high_agri["gdp_growth_pct"]) if len(high_agri) >= 5 else (np.nan, np.nan)
r_low, p_low = stats.pearsonr(low_agri["rainfall_anomaly_pct"], low_agri["gdp_growth_pct"]) if len(low_agri) >= 5 else (np.nan, np.nan)

