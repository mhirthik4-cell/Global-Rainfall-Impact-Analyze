c_param = ";".join(COUNTRIES)

INDICATORS = {
    "rainfall_mm": "AG.LND.PRCP.MM",        # Average precipitation in depth (mm/year)
    "gdp_growth_pct": "NY.GDP.MKTP.KD.ZG",    # Real GDP growth (annual %)
    "gdp_current_usd": "NY.GDP.MKTP.CD",      # GDP current USD
    "agri_gdp_share_pct": "NV.AGR.TOTL.ZS",   # Agriculture, forestry, fishing (% of GDP)
    "agri_growth_pct": "NV.AGR.TOTL.KD.ZG",   # Agriculture value added (annual % growth)
}

print(f"\n[1/5] Fetching live indicators from World Bank API for {len(COUNTRIES)} countries (1990–2023)...")

wb_records = {}
for name, code in INDICATORS.items():
    url = f"http://api.worldbank.org/v2/country/{c_param}/indicator/{code}?date=1990:2023&format=json&per_page=1000"
    try:
        r = requests.get(url, timeout=30)
        data = r.json()
        rows = []
        if isinstance(data, list) and len(data) > 1:
            for item in data[1]:
                iso = item.get("countryiso3code") or item.get("country", {}).get("id")
                cname = item.get("country", {}).get("value")
                yr = item.get("date")
                val = item.get("value")
                if iso and yr:
                    rows.append({
                        "country_iso3": str(iso).strip().upper()[:3],
                        "country_name": str(cname).strip(),
                        "year": int(yr),
                        name: float(val) if val is not None else np.nan
                    })
        wb_records[name] = pd.DataFrame(rows)
        print(f"  ✓ Retrieved {name} ({len(rows)} records)")
    except Exception as e:
        print(f"  ✗ Error retrieving {name}: {e}")
        wb_records[name] = pd.DataFrame(columns=["country_iso3", "country_name", "year", name])

# Harmonize World Bank Panel
master = wb_records["rainfall_mm"].copy()
for name in ["gdp_growth_pct", "gdp_current_usd", "agri_gdp_share_pct", "agri_growth_pct"]:
    if name in wb_records and not wb_records[name].empty:
        master = pd.merge(master, wb_records[name][["country_iso3", "year", name]], on=["country_iso3", "year"], how="outer")

